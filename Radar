        function getFilteredJobs() {
            const keyword = (document.getElementById('searchInput')?.value || '').toLowerCase().trim();
            const category = document.getElementById('categorySelect')?.value || 'ALL';
            const district = document.getElementById('districtSelect')?.value || 'ALL';
            const source = document.getElementById('sourceSelect')?.value || 'ALL';
            const paidOnly = document.getElementById('filterPaidOnly')?.checked || false;
            const stampOnly = document.getElementById('filterStampOnly')?.checked || false;
            const noExpOnly = document.getElementById('filterNoExpOnly')?.checked || false;
            const sortBy = document.getElementById('sortSelect')?.value || 'NEWEST';

            let filtered = jobsData.filter(job => {
                if (category !== 'ALL' && job.category !== category) return false;
                if (district !== 'ALL' && !job.district.toLowerCase().includes(district.toLowerCase()) && !job.address.toLowerCase().includes(district.toLowerCase())) return false;
                if (source !== 'ALL' && job.source !== source) return false;
                if (paidOnly && !job.paid) return false;
                if (stampOnly && !job.stampSupport) return false;
                if (noExpOnly && !job.noExpRequired) return false;

                if (keyword) {
                    const haystack = [
                        job.title,
                        job.company,
                        job.district,
                        job.address,
                        job.categoryLabel,
                        ...(job.skills || []),
                        ...(job.tasks || [])
                    ].join(' ').toLowerCase();
                    if (!haystack.includes(keyword)) return false;
                }
                return true;
            });

            if (sortBy === 'NEWEST') {
                filtered.sort((a, b) => a.postedMinutesAgo - b.postedMinutesAgo);
            } else if (sortBy === 'ALLOWANCE_HIGH') {
                filtered.sort((a, b) => (b.allowanceValue || 0) - (a.allowanceValue || 0));
            } else if (sortBy === 'URGENT') {
                filtered.sort((a, b) => (b.urgent === a.urgent ? a.postedMinutesAgo - b.postedMinutesAgo : b.urgent ? 1 : -1));
            }

            return filtered;
        }

