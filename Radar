                                <p class="text-xs text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
                                    <i class="fa-solid fa-location-dot text-rose-500"></i>
                                    <span><strong class="text-slate-700 dark:text-slate-200">${job.district}</strong> — ${job.address}</span>
                                </p>
                            </div>
                        </div>

                        <!-- Right Allowance & Direct Action Buttons -->
                        <div class="flex sm:flex-col items-center sm:items-end justify-between gap-2 shrink-0 border-t sm:border-t-0 pt-2.5 sm:pt-0 border-slate-100 dark:border-slate-800">
                            <div class="text-left sm:text-right">
                                <span class="text-[10px] uppercase tracking-wider text-slate-400 block">Trợ cấp thực tập</span>
                                <span class="text-xs sm:text-sm font-extrabold text-emerald-600 dark:text-emerald-400">
                                    ${job.allowance}
                                </span>
                            </div>
                            <div class="flex flex-wrap items-center gap-1.5">
                                <button onclick="toggleSaveJob('${job.id}')" class="p-2 rounded-xl border ${isSaved ? 'bg-amber-500/10 border-amber-500/40 text-amber-500' : 'border-slate-200 dark:border-slate-700 text-slate-400 hover:text-amber-500'} transition" title="Lưu công việc">
                                    <i class="${isSaved ? 'fa-solid' : 'fa-regular'} fa-bookmark text-xs"></i>
                                </button>
                                <button onclick="openJobDetail('${job.id}')" class="px-2.5 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-semibold transition">
                                    Chi tiết
                                </button>
                                <a href="${links.googleJobsUrl}" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1.5 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 border border-rose-500/25 text-xs font-semibold flex items-center gap-1 transition" title="Mở đúng bài đăng này trên Google Jobs">
                                    <i class="fa-brands fa-google text-[10px]"></i>
                                    <span>Google Jobs</span>
                                </a>
                                <a href="${links.primaryPostUrl}" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold flex items-center gap-1.5 shadow-sm transition" title="Mở thẳng bài đăng gốc">
                                    <span>Bài đăng gốc</span>
                                    <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Skills & Perks Footer -->
                    <div class="mt-3.5 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex flex-wrap items-center justify-between gap-2">
                        <div class="flex flex-wrap items-center gap-1.5">
                            ${(job.skills || []).map(skill => `
                                <span class="px-2 py-0.5 rounded-md text-[11px] bg-slate-100 dark:bg-slate-800/90 text-slate-600 dark:text-slate-300 font-medium">
                                    #${skill}
                                </span>
                            `).join('')}
                        </div>
                        <div class="flex items-center gap-3 text-[11px] text-slate-500 dark:text-slate-400">
                            ${job.stampSupport ? `<span class="text-cyan-600 dark:text-cyan-400 font-medium"><i class="fa-solid fa-stamp mr-1"></i>Hỗ trợ dấu mộc</span>` : ''}
                            ${job.noExpRequired ? `<span class="text-emerald-600 dark:text-emerald-400 font-medium"><i class="fa-solid fa-seedling mr-1"></i>Training từ đầu</span>` : ''}
                        </div>
                    </div>
                </article>
                `;
            }).join('');
        }

        function handleFilterChange() {
            renderJobs();
        }

        function applyQuickTag(tagText) {
            const searchInput = document.getElementById('searchInput');
            if (searchInput) {
                searchInput.value = tagText;
                handleFilterChange();
                showToast('Đã áp dụng bộ lọc nhanh', `Đang lọc theo từ khóa "${tagText}" tại TP.HCM`, 'blue');
            }
        }

        function resetFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('categorySelect').value = 'ALL';
            document.getElementById('districtSelect').value = 'ALL';
            document.getElementById('sourceSelect').value = 'ALL';
            document.getElementById('filterPaidOnly').checked = false;
            document.getElementById('filterStampOnly').checked = false;
            document.getElementById('filterNoExpOnly').checked = false;
            document.getElementById('sortSelect').value = 'NEWEST';
            renderJobs();
        }

        // Open Job Detail Modal & Generate Tailored Logistics Cover Letter
        function openJobDetail(jobId) {
            const job = jobsData.find(j => j.id === jobId);
            if (!job) return;
            activeModalJobId = jobId;

            document.getElementById('modalSourceBadge').textContent = `Nguồn: ${job.source}`;
            document.getElementById('modalPostedTime').textContent = formatRelativeTime(job.postedMinutesAgo);
            document.getElementById('modalJobTitle').textContent = job.title;
            document.getElementById('modalCompanyName').textContent = `${job.company} • ${job.address}`;
            document.getElementById('modalAllowance').textContent = job.allowance;
            document.getElementById('modalLocation').textContent = `${job.district}, TP.HCM`;
            document.getElementById('modalStamp').textContent = job.stampSupport ? 'Có hỗ trợ mộc đỏ & số liệu' : 'Trao đổi khi phỏng vấn';
            document.getElementById('modalSchedule').textContent = job.schedule || 'Linh hoạt theo lịch học';

            document.getElementById('modalTasks').innerHTML = (job.tasks || []).map(t => `<li>${t}</li>`).join('');
            document.getElementById('modalRequirements').innerHTML = (job.requirements || []).map(r => `<li>${r}</li>`).join('');
            document.getElementById('modalBenefits').innerHTML = (job.benefits || []).map(b => `<li>${b}</li>`).join('');

            // Generate Cover Letter
            const coverLetter = `Tiêu đề: [Ứng tuyển ${job.title}] - [Họ và Tên của bạn] - Sinh viên Logistics/XNK

Kính gửi Bộ phận Tuyển dụng ${job.company},

Em được biết Quý công ty tại ${job.district}, TP.HCM đang tuyển dụng vị trí "${job.title}". Là sinh viên chuyên ngành Logistics & Quản lý Chuỗi cung ứng tại TP.HCM, đã được trang bị kiến thức về ${(job.skills || []).slice(0, 3).join(', ')}, em rất mong muốn được thực tập và hỗ trợ đội ngũ của Quý công ty.

Em có thể đảm bảo lịch thực tập (${job.schedule}) và sẵn sàng học hỏi nhanh các nghiệp vụ thực tế tại công ty. Em xin đính kèm CV bên dưới để Anh/Chị xem xét.

Em xin chân thành cảm ơn!
Trân trọng,
[Họ và Tên] - [Số điện thoại]`;

            document.getElementById('modalCoverLetter').value = coverLetter;

            // Resolve Exact Post URLs
            const links = resolveJobLinks(job);
            document.getElementById('modalApplyExternalBtn').href = links.primaryPostUrl;
            document.getElementById('modalExternalSearchBtn').href = links.googleJobsUrl;
            document.getElementById('modalDirectLuckyBtn').href = links.luckyPostUrl;

            const rawUrlDisplay = document.getElementById('modalRawUrlDisplay');
            if (rawUrlDisplay) {
                rawUrlDisplay.textContent = links.primaryPostUrl;
            }
            const linkBadge = document.getElementById('modalLinkTypeBadge');
            if (linkBadge) {
                linkBadge.textContent = job.isDirectPostUrl
                    ? '✔ Link bài đăng gốc trực tiếp (Đã xác thực ID)'
                    : '🎯 Định tuyến tự động thẳng vào bài đăng gốc';
            }

            // Update Save Button inside Modal
            const saveBtn = document.getElementById('modalSaveBtn');
            const isSaved = savedJobIds.includes(job.id);
            saveBtn.innerHTML = isSaved
                ? '<i class="fa-solid fa-bookmark text-amber-500"></i> Đã lưu tin này'
                : '<i class="fa-regular fa-bookmark"></i> Lưu tin này';
            saveBtn.onclick = () => {
                toggleSaveJob(job.id);
                openJobDetail(job.id);
            };

            openModal('jobDetailModal');
        }

        function copyCoverLetter() {
            const textarea = document.getElementById('modalCoverLetter');
            if (!textarea) return;
            textarea.select();
            textarea.setSelectionRange(0, 99999);
            try {
                document.execCommand('copy');
                showToast('Đã sao chép Email', 'Mẫu email ứng tuyển thực tập đã được lưu vào bộ nhớ tạm.', 'emerald');
            } catch (err) {
                showToast('Lỗi sao chép', 'Vui lòng nhấn Ctrl+C để sao chép thủ công.', 'amber');
            }
        }

        function toggleSaveJob(jobId) {
            const idx = savedJobIds.indexOf(jobId);
            if (idx === -1) {
                savedJobIds.push(jobId);
                if (!savedJobStatuses[jobId]) {
                    savedJobStatuses[jobId] = 'CHUA_NOP';
                }
                showToast('Đã lưu việc làm', 'Đã thêm vào danh sách theo dõi thực tập của bạn.', 'amber');
            } else {
                savedJobIds.splice(idx, 1);
                showToast('Đã bỏ lưu', 'Đã xóa việc làm khỏi danh sách lưu.', 'blue');
            }
            localStorage.setItem('logi_hcm_saved_jobs', JSON.stringify(savedJobIds));
            localStorage.setItem('logi_hcm_job_statuses', JSON.stringify(savedJobStatuses));
            renderJobs();
            renderSavedJobsModal();
        }

        function updateSavedJobStatus(jobId, newStatus) {
            savedJobStatuses[jobId] = newStatus;
            localStorage.setItem('logi_hcm_job_statuses', JSON.stringify(savedJobStatuses));
            showToast('Đã cập nhật trạng thái', 'Tiến độ ứng tuyển đã được lưu lại.', 'emerald');
        }

        function renderSavedJobsModal() {
            const container = document.getElementById('savedJobsContainer');
            if (!container) return;

            const savedList = jobsData.filter(j => savedJobIds.includes(j.id));
            if (savedList.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-8 text-slate-500 dark:text-slate-400 space-y-2">
                        <i class="fa-regular fa-bookmark text-2xl text-slate-400"></i>
                        <p class="font-semibold">Bạn chưa lưu công việc thực tập nào.</p>
                        <p class="text-[11px]">Hãy bấm vào biểu tượng dấu trang trên các tin tuyển dụng để lưu và theo dõi tiến độ nộp CV.</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = savedList.map(job => {
                const status = savedJobStatuses[job.id] || 'CHUA_NOP';
                return `
                    <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div class="space-y-1">
                            <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-blue-500/10 text-blue-500">${job.source} • ${job.district}</span>
                            <h4 onclick="closeModal('savedJobsModal'); openJobDetail('${job.id}')" class="font-bold text-slate-900 dark:text-white hover:text-blue-500 cursor-pointer">
                                ${job.title}
                            </h4>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400">${job.company} — <strong class="text-emerald-500">${job.allowance}</strong></p>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <select onchange="updateSavedJobStatus('${job.id}', this.value)" class="text-xs px-2.5 py-1.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700">
                                <option value="CHUA_NOP" ${status === 'CHUA_NOP' ? 'selected' : ''}>📌 Đang chuẩn bị CV</option>
                                <option value="DA_NOP" ${status === 'DA_NOP' ? 'selected' : ''}>📨 Đã gửi CV</option>
                                <option value="PHONG_VAN" ${status === 'PHONG_VAN' ? 'selected' : ''}>🤝 Chờ phỏng vấn</option>
                                <option value="NHAN_OFFER" ${status === 'NHAN_OFFER' ? 'selected' : ''}>🎉 Đã đậu thực tập</option>
                            </select>
                            <button onclick="toggleSaveJob('${job.id}')" class="p-2 rounded-xl bg-rose-500/10 text-rose-500 hover:bg-rose-500 hover:text-white transition" title="Xóa">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function renderConnectors() {
            const container = document.getElementById('connectorsList');
            const countSpan = document.getElementById('activeSourceCount');
            if (countSpan) {
                countSpan.textContent = externalConnectors.filter(c => c.active).length;
            }
            if (!container) return;

            container.innerHTML = externalConnectors.map((conn, index) => `
                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80">
                    <div class="space-y-0.5 pr-3">
                        <div class="flex items-center gap-2">
                            <span class="font-bold text-slate-800 dark:text-slate-200">${conn.name}</span>
                            <span class="text-[10px] px-2 py-0.5 rounded-full border ${conn.badgeColor}">${conn.protocol}</span>
                        </div>
                        <p class="text-[11px] text-slate-400 font-mono truncate max-w-md">${conn.endpoint}</p>
                    </div>
                    <label class="flex items-center cursor-pointer">
                        <input type="checkbox" ${conn.active ? 'checked' : ''} onchange="toggleConnector(${index})" class="rounded text-blue-600 w-4 h-4">
                    </label>
                </div>
            `).join('');
        }

        function toggleConnector(index) {
            if (!externalConnectors[index]) return;
            externalConnectors[index].active = !externalConnectors[index].active;
            const c = externalConnectors[index];
            logTerminal(`${c.active ? '✔ Đã kích hoạt' : '⏸ Đã tạm ngắt'} nguồn kết nối [${c.name}].`, c.active ? 'success' : 'warn');
            renderConnectors();
        }

        async function addCustomConnector() {
            const nameInput = document.getElementById('customSourceName');
            const urlInput = document.getElementById('customSourceUrl');
            const name = (nameInput?.value || '').trim();
            const url = (urlInput?.value || '').trim();

            if (!name || !url) {
                showToast('Thiếu thông tin', 'Vui lòng nhập đầy đủ Tên nguồn và URL RSS/API.', 'amber');
                return;
            }

            externalConnectors.push({
                id: 'custom-' + Date.now(),
                name: name,
                protocol: 'Custom CORS Feed',
                endpoint: url,
                searchUrlTemplate: url,
                active: true,
                badgeColor: 'bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/30'
            });

            // Update source dropdown filter
            const sourceSelect = document.getElementById('sourceSelect');
            if (sourceSelect) {
                const opt = document.createElement('option');
                opt.value = name;
                opt.textContent = name;
                sourceSelect.appendChild(opt);
            }

            nameInput.value = '';
            urlInput.value = '';
            renderConnectors();
            logTerminal(`🔌 Đã thêm nguồn mở tùy chỉnh [${name}] qua CORS Proxy: ${url}`, 'success');
            showToast('Đã thêm nguồn mới', `Đã kết nối ${name} vào luồng quét thời gian thực.`, 'emerald');
            triggerRealtimeSync(true);
        }

        function openModal(modalId) {
            const modal = document.getElementById(modalId);
            if (!modal) return;
            if (modalId === 'savedJobsModal') renderSavedJobsModal();
            if (modalId === 'sourceConfigModal') renderConnectors();
            modal.classList.remove('hidden');
        }

        function closeModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) modal.classList.add('hidden');
        }

        function toggleTheme() {
            const htmlEl = document.documentElement;
            htmlEl.classList.toggle('dark');
            const isDark = htmlEl.classList.contains('dark');
            localStorage.setItem('logi_hcm_theme', isDark ? 'dark' : 'light');
        }

        function showToast(title, message, color = 'blue') {
            const container = document.getElementById('toastContainer');
            if (!container) return;

            const borderColors = {
                emerald: 'border-emerald-500/50 bg-slate-900/95 text-white',
                blue: 'border-blue-500/50 bg-slate-900/95 text-white',
                amber: 'border-amber-500/50 bg-slate-900/95 text-white'
            };

            const iconColors = {
                emerald: 'fa-solid fa-bolt text-emerald-400',
                blue: 'fa-solid fa-circle-info text-blue-400',
                amber: 'fa-solid fa-bookmark text-amber-400'
            };

            const toast = document.createElement('div');
            toast.className = `pointer-events-auto flex items-start gap-3 p-3.5 rounded-2xl border shadow-xl backdrop-blur-md transition-all duration-300 ${borderColors[color] || borderColors.blue}`;
            toast.innerHTML = `
                <div class="mt-0.5 text-sm">
                    <i class="${iconColors[color] || iconColors.blue}"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-xs font-bold truncate">${title}</p>
                    <p class="text-[11px] text-slate-300 line-clamp-2 mt-0.5">${message}</p>
                </div>
            `;

            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(8px)';
                setTimeout(() => toast.remove(), 300);
            }, 3800);
        }

        // Initialize Application on Load
        window.addEventListener('DOMContentLoaded', () => {
            const savedTheme = localStorage.getItem('logi_hcm_theme');
            if (savedTheme === 'light') {
                document.documentElement.classList.remove('dark');
            }

            const nowStr = new Date().toLocaleTimeString('vi-VN', { hour12: false });
            document.getElementById('statLastSync').textContent = nowStr;

            logTerminal('🚀 Khởi tạo LogiIntern HCMC Open-Source Radar v2.5...', 'info');
            logTerminal('📡 Đã kết nối 6 cổng việc làm Logistics tại TP. Hồ Chí Minh.', 'success');
            logTerminal('⏱ Chế độ tự động cập nhật (Auto-Sync) đang chạy mỗi 30 giây.', 'fetch');

            renderConnectors();
            renderJobs();
            startAutoSyncTimer();

            // Immediately fetch real live job postings with exact URLs on startup
            setTimeout(() => {
                triggerRealtimeSync(false);
            }, 800);
        });
    </script>
</body>
</html>
