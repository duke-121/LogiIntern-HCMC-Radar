<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LogiIntern HCMC Radar | Săn Thực Tập Sinh Logistics TP.HCM Thời Gian Thực</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            400: '#60a5fa',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.4);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(100, 116, 139, 0.5);
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(59, 130, 246, 0.8);
        }
        @keyframes pulse-ring {
            0% { transform: scale(0.8); opacity: 0.8; }
            100% { transform: scale(2.2); opacity: 0; }
        }
        .radar-dot::before {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 9999px;
            background-color: #10b981;
            animation: pulse-ring 1.8s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
        }
        @keyframes slideInNew {
            from { opacity: 0; transform: translateY(-12px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        .job-card-new {
            animation: slideInNew 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 min-h-screen flex flex-col transition-colors duration-200">

    <!-- Top Header & Live Sync Bar -->
    <header class="sticky top-0 z-30 backdrop-blur-xl bg-white/85 dark:bg-slate-900/90 border-b border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
                <!-- Brand & Status -->
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-blue-600 via-indigo-600 to-cyan-500 flex items-center justify-center text-white shadow-lg shadow-blue-500/25">
                            <i class="fa-solid fa-ship text-lg"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h1 class="text-lg sm:text-xl font-extrabold tracking-tight bg-gradient-to-r from-blue-600 via-cyan-500 to-emerald-500 bg-clip-text text-transparent">
                                    LogiIntern HCMC Radar
                                </h1>
                                <span class="px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 rounded-full flex items-center gap-1.5">
                                    <span class="relative inline-flex w-2 h-2 rounded-full bg-emerald-500 radar-dot"></span>
                                    Open-Source Hub
                                </span>
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400">
                                Cổng săn việc <span class="font-semibold text-slate-700 dark:text-slate-200">Thực tập sinh Logistics & Xuất Nhập Khẩu</span> tại TP. Hồ Chí Minh
                            </p>
                        </div>
                    </div>

                    <!-- Mobile Theme Toggle -->
                    <button id="themeToggleMobile" onclick="toggleTheme()" class="lg:hidden p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200">
                        <i class="fa-solid fa-moon dark:hidden"></i>
                        <i class="fa-solid fa-sun hidden dark:inline"></i>
                    </button>
                </div>

                <!-- Real-Time Sync Control Panel -->
                <div class="flex flex-wrap items-center gap-2 sm:gap-3 bg-slate-100/90 dark:bg-slate-800/70 p-2 rounded-2xl border border-slate-200/80 dark:border-slate-700/70">
                    <!-- Live Auto-Update Switch -->
                    <div class="flex items-center gap-2.5 px-2.5 py-1 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700/80">
                        <label for="autoSyncToggle" class="flex items-center cursor-pointer gap-2 text-xs font-medium select-none">
                            <input type="checkbox" id="autoSyncToggle" checked onchange="toggleAutoSync()" class="sr-only peer">
                            <div class="w-9 h-5 bg-slate-300 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all relative peer-checked:bg-emerald-500"></div>
                            <span class="text-slate-700 dark:text-slate-200 font-semibold">Tự động cập nhật</span>
                        </label>
                        <select id="syncIntervalSelect" onchange="updateSyncInterval()" class="text-xs bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg px-2 py-1 border border-slate-200 dark:border-slate-700 focus:outline-none">
                            <option value="15">15 giây</option>
                            <option value="30" selected>30 giây</option>
                            <option value="60">60 giây</option>
                        </select>
                        <span id="countdownBadge" class="font-mono text-[11px] px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold">
                            30s
                        </span>
                    </div>

                    <!-- Manual Sync Button -->
                    <button id="syncNowBtn" onclick="triggerRealtimeSync(true)" class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 active:scale-95 text-white text-xs font-semibold shadow-md shadow-blue-600/25 transition-all">
                        <i id="syncIcon" class="fa-solid fa-rotate"></i>
                        <span>Cập nhật ngay</span>
                    </button>

                    <!-- Open-Source API Config Modal Button -->
                    <button onclick="openModal('sourceConfigModal')" class="flex items-center gap-1.5 px-3 py-2 rounded-xl bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 text-xs font-medium transition">
                        <i class="fa-solid fa-plug-circle-check text-cyan-500"></i>
                        <span>Nguồn mở (<span id="activeSourceCount">6</span>)</span>
                    </button>

                    <!-- Saved Jobs Button -->
                    <button onclick="openModal('savedJobsModal')" class="relative flex items-center gap-1.5 px-3 py-2 rounded-xl bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 text-xs font-medium transition">
                        <i class="fa-solid fa-bookmark text-amber-500"></i>
                        <span class="hidden sm:inline">Đã lưu</span>
                        <span id="savedCountBadge" class="px-1.5 py-0.2 rounded-full bg-amber-500/20 text-amber-600 dark:text-amber-400 font-bold text-[11px]">0</span>
                    </button>

                    <!-- Desktop Theme Toggle -->
                    <button onclick="toggleTheme()" class="hidden lg:flex items-center justify-center w-9 h-9 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:text-blue-500 transition" title="Đổi giao diện Sáng/Tối">
                        <i class="fa-solid fa-moon dark:hidden"></i>
                        <i class="fa-solid fa-sun hidden dark:inline text-amber-400"></i>
                    </button>
                </div>
            </div>

            <!-- Live Sync Progress Bar -->
            <div class="w-full bg-slate-200 dark:bg-slate-800 h-1 mt-2.5 rounded-full overflow-hidden">
                <div id="syncProgressBar" class="bg-gradient-to-r from-blue-500 via-cyan-400 to-emerald-400 h-full transition-all duration-1000" style="width: 100%"></div>
            </div>
        </div>
    </header>

    <!-- Direct Deep-Search External Portals Bridge -->
    <section class="bg-white/60 dark:bg-slate-900/50 border-b border-slate-200/80 dark:border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 flex flex-wrap items-center justify-between gap-2 text-xs">
            <div class="flex items-center gap-2 text-slate-600 dark:text-slate-400">
                <span class="inline-flex items-center gap-1 font-semibold text-blue-600 dark:text-cyan-400">
                    <i class="fa-solid fa-satellite-dish"></i> Kết nối truy vấn trực tiếp ngoài (Deep-Link TP.HCM):
                </span>
                <span class="hidden md:inline text-slate-400">Mở kết quả tìm kiếm trực tiếp trên các trang tuyển dụng với từ khóa đang lọc</span>
            </div>
            <div class="flex flex-wrap items-center gap-1.5" id="externalPortalLinks">
                <!-- Populated dynamically based on current search query -->
            </div>
        </div>
    </section>

    <!-- Main Content Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full">

        <!-- Real-Time KPI & Logistics HCMC Pulse -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6">
            <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">Tổng Job Thực Tập TP.HCM</p>
                    <p id="statTotalJobs" class="text-2xl font-extrabold text-slate-900 dark:text-white mt-1">0</p>
                    <p class="text-[11px] text-emerald-600 dark:text-emerald-400 mt-0.5 flex items-center gap-1">
                        <i class="fa-solid fa-bolt"></i> Đang hoạt động
                    </p>
                </div>
                <div class="w-11 h-11 rounded-2xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center text-lg">
                    <i class="fa-solid fa-boxes-packing"></i>
                </div>
            </div>

            <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">Có Trợ Cấp Thực Tập</p>
                    <p id="statPaidJobs" class="text-2xl font-extrabold text-emerald-600 dark:text-emerald-400 mt-1">0</p>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">2.0 - 6.5 Triệu/tháng</p>
                </div>
                <div class="w-11 h-11 rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-lg">
                    <i class="fa-solid fa-hand-holding-dollar"></i>
                </div>
            </div>

            <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">Hỗ Trợ Dấu Mộc & Báo Cáo</p>
                    <p id="statStampJobs" class="text-2xl font-extrabold text-cyan-600 dark:text-cyan-400 mt-1">0</p>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Dành cho SV năm 3 & 4</p>
                </div>
                <div class="w-11 h-11 rounded-2xl bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 flex items-center justify-center text-lg">
                    <i class="fa-solid fa-stamp"></i>
                </div>
            </div>

            <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">Lần Cập Nhật Cuối</p>
                    <p id="statLastSync" class="text-lg font-mono font-bold text-indigo-600 dark:text-indigo-400 mt-1">--:--:--</p>
                    <p id="statSyncStatus" class="text-[11px] text-emerald-600 dark:text-emerald-400 mt-0.5 truncate">Sẵn sàng đồng bộ</p>
                </div>
                <div class="w-11 h-11 rounded-2xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-lg">
                    <i class="fa-solid fa-tower-broadcast"></i>
                </div>
            </div>
        </div>

        <!-- Main 2-Column Layout: Left Sidebar Filters & Live Terminal | Right Job Stream -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- Left Column: Filters & Open-Source Live Terminal (4 cols) -->
            <aside class="lg:col-span-4 space-y-5">

                <!-- Filter Card -->
                <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-5 shadow-sm space-y-4">
                    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
                        <h2 class="font-bold text-sm flex items-center gap-2">
                            <i class="fa-solid fa-sliders text-blue-500"></i>
                            Bộ Lọc Thực Tập Logistics TP.HCM
                        </h2>
                        <button onclick="resetFilters()" class="text-xs text-blue-600 dark:text-blue-400 hover:underline font-medium">
                            Đặt lại
                        </button>
                    </div>

                    <!-- Keyword Search -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">
                            Từ khóa (Vị trí, Kỹ năng, Công ty)
                        </label>
                        <div class="relative">
                            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                            <input type="text" id="searchInput" oninput="handleFilterChange()" placeholder="VD: Chứng từ, Khai báo hải quan, Forwarder, Kuehne..." class="w-full pl-9 pr-3 py-2.5 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/90 border border-slate-200 dark:border-slate-700 focus:outline-none focus:border-blue-500 transition">
                        </div>
                    </div>

                    <!-- Logistics Sub-field -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">
                            Mảng nghiệp vụ Logistics
                        </label>
                        <select id="categorySelect" onchange="handleFilterChange()" class="w-full px-3 py-2.5 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/90 border border-slate-200 dark:border-slate-700 focus:outline-none focus:border-blue-500">
                            <option value="ALL">Tất cả mảng Logistics & Chuỗi cung ứng</option>
                            <option value="DOCS">Chứng từ Xuất Nhập Khẩu (Docs / Cus Service)</option>
                            <option value="CUSTOMS">Khai báo Hải quan & Hiện trường (Ops / Customs)</option>
                            <option value="FORWARDING">Giao nhận Vận tải Quốc tế (Sea / Air Freight)</option>
                            <option value="SUPPLY_CHAIN">Chuỗi cung ứng & Thu mua (Supply Chain / Purchasing)</option>
                            <option value="WAREHOUSE">Vận hành Kho bãi & E-Logistics (Warehouse / Fulfillment)</option>
                            <option value="SALES">Sales Logistics / Tuyến Hàng Hải (Sales Forwarder)</option>
                        </select>
                    </div>

                    <!-- HCMC District Filter -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">
                            Khu vực trọng điểm tại TP. Hồ Chí Minh
                        </label>
                        <select id="districtSelect" onchange="handleFilterChange()" class="w-full px-3 py-2.5 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/90 border border-slate-200 dark:border-slate-700 focus:outline-none focus:border-blue-500">
                            <option value="ALL">Toàn TP. Hồ Chí Minh</option>
                            <option value="Tân Bình">Quận Tân Bình (Khu Sân bay Tân Sơn Nhất / Air Cargo)</option>
                            <option value="Quận 1">Quận 1 (Văn phòng Hãng tàu & Forwarder Quốc tế)</option>
                            <option value="Quận 4">Quận 4 (Khu Cảng Sài Gòn / Vân Đồn)</option>
                            <option value="Quận 7">Quận 7 (KCX Tân Thuận / Phú Mỹ Hưng)</option>
                            <option value="Thủ Đức">TP. Thủ Đức (Cảng Cát Lái / ICD Sotrans / Khu CNC)</option>
                            <option value="Bình Thạnh">Quận Bình Thạnh (Khu Điện Biên Phủ / Cầu Sài Gòn)</option>
                            <option value="Phú Nhuận">Quận Phú Nhuận (Khu Nguyễn Văn Trỗi)</option>
                        </select>
                    </div>

                    <!-- Source Platform Filter -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">
                            Nguồn trang web bên ngoài
                        </label>
                        <select id="sourceSelect" onchange="handleFilterChange()" class="w-full px-3 py-2.5 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/90 border border-slate-200 dark:border-slate-700 focus:outline-none focus:border-blue-500">
                            <option value="ALL">Tất cả nguồn mở kết nối (6 nguồn)</option>
                            <option value="TopCV VN">TopCV Vietnam</option>
                            <option value="VietnamWorks">VietnamWorks</option>
                            <option value="Glints VN">Glints Vietnam</option>
                            <option value="CareerViet">CareerViet</option>
                            <option value="LinkedIn Jobs">LinkedIn Jobs VN</option>
                            <option value="Ybox / JobsGO">Ybox & JobsGO</option>
                        </select>
                    </div>

                    <!-- Quick Checkboxes -->
                    <div class="pt-1 space-y-2.5">
                        <label class="flex items-center gap-2.5 text-xs cursor-pointer select-none">
                            <input type="checkbox" id="filterPaidOnly" onchange="handleFilterChange()" class="rounded text-blue-600 focus:ring-0 w-4 h-4">
                            <span class="text-slate-700 dark:text-slate-300">Chỉ hiện job <strong>Có trợ cấp tiền mặt</strong></span>
                        </label>
                        <label class="flex items-center gap-2.5 text-xs cursor-pointer select-none">
                            <input type="checkbox" id="filterStampOnly" onchange="handleFilterChange()" class="rounded text-blue-600 focus:ring-0 w-4 h-4">
                            <span class="text-slate-700 dark:text-slate-300">Hỗ trợ <strong>Dấu mộc & số liệu khóa luận</strong></span>
                        </label>
                        <label class="flex items-center gap-2.5 text-xs cursor-pointer select-none">
                            <input type="checkbox" id="filterNoExpOnly" onchange="handleFilterChange()" class="rounded text-blue-600 focus:ring-0 w-4 h-4">
                            <span class="text-slate-700 dark:text-slate-300">Không yêu cầu kinh nghiệm (Training từ đầu)</span>
                        </label>
                    </div>
                </div>

                <!-- Live Open-Source Connector Terminal -->
                <div class="bg-slate-900 text-slate-200 rounded-2xl border border-slate-800 p-4 shadow-lg">
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                            <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-300">
                                Open-Source Feed Stream
                            </h3>
                        </div>
                        <button onclick="clearTerminalLog()" class="text-[11px] font-mono text-slate-400 hover:text-white">
                            [Xóa log]
                        </button>
                    </div>
                    <div id="networkTerminal" class="font-mono text-[11px] space-y-1.5 h-48 overflow-y-auto bg-slate-950/90 p-3 rounded-xl border border-slate-800/90 leading-relaxed">
                        <!-- Live logs injected here -->
                    </div>
                    <div class="mt-3 pt-2.5 border-t border-slate-800 flex items-center justify-between text-[11px] text-slate-400">
                        <span>Proxy: <code class="text-cyan-400">allorigins / rss2json</code></span>
                        <button onclick="openModal('sourceConfigModal')" class="text-blue-400 hover:underline font-medium">
                            + Thêm RSS/API riêng
                        </button>
                    </div>
                </div>
            </aside>

            <!-- Right Column: Job Feed List (8 cols) -->
            <section class="lg:col-span-8 space-y-4">

                <!-- Feed Header & Quick Tags -->
                <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-4 shadow-sm">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div>
                            <h2 class="text-base font-bold flex items-center gap-2">
                                <span>Danh sách việc làm Thực tập Logistics TP.HCM</span>
                                <span id="visibleJobsBadge" class="px-2.5 py-0.5 text-xs rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 font-bold">0</span>
                            </h2>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                                Tự động làm mới và đẩy thông báo khi phát hiện tin tuyển dụng mới từ các nguồn ngoài
                            </p>
                        </div>

                        <div class="flex items-center gap-2">
                            <span class="text-xs text-slate-500 whitespace-nowrap">Sắp xếp:</span>
                            <select id="sortSelect" onchange="handleFilterChange()" class="text-xs bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2 focus:outline-none">
                                <option value="NEWEST">Mới cập nhật nhất</option>
                                <option value="ALLOWANCE_HIGH">Trợ cấp cao nhất</option>
                                <option value="URGENT">Tuyển gấp đi làm ngay</option>
                            </select>
                        </div>
                    </div>

