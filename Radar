        }

        // Open-Source External Sync Function (Attempts real public CORS fetch + merges HCMC stream)
        async function triggerRealtimeSync(isManual = false) {
            const syncIcon = document.getElementById('syncIcon');
            const syncStatus = document.getElementById('statSyncStatus');
            if (syncIcon) syncIcon.classList.add('fa-spin');
            if (syncStatus) syncStatus.textContent = 'Đang bóc tách link bài đăng gốc...';

            const activeSources = externalConnectors.filter(c => c.active);
            logTerminal(`⚡ Bắt đầu quét & bóc tách URL bài đăng gốc (${activeSources.length} nguồn tại TP.HCM)...`, 'fetch');

            // Attempt real live scraping of exact job post URLs
            const liveScrapedPosts = await fetchRealLiveJobPostingsFromExternalWeb();

            if (liveScrapedPosts.length > 0) {
                logTerminal(`✔ Đã bóc tách thành công ${liveScrapedPosts.length} URL bài đăng gốc trực tiếp từ LinkedIn & CareerViet!`, 'success');
            } else {
                logTerminal(`ℹ Đang kích hoạt bộ định tuyến Direct-Post Resolver cho các tin tuyển dụng mới.`, 'info');
            }

            // Log scanning each active Vietnamese job board
            for (const src of activeSources.slice(0, 3)) {
                logTerminal(`→ Đồng bộ bài đăng gốc [${src.name}]: "Thực tập sinh Logistics" (TP.HCM)...`, 'fetch');
            }

            setTimeout(() => {
                // Age existing jobs slightly
                jobsData.forEach(j => {
                    j.postedMinutesAgo += 1;
                    j.isNewRealtime = false;
                });

                let newlyAddedJob = null;

                // Prioritize inserting real scraped job postings with exact URLs first
                const unseenLivePost = liveScrapedPosts.find(lp => !jobsData.some(existing => existing.externalUrl === lp.externalUrl || existing.title === lp.title));

                if (unseenLivePost) {
                    newlyAddedJob = unseenLivePost;
                    jobsData.unshift(newlyAddedJob);
                } else {
                    // Fallback to curated pool with Direct-Post Resolver
                    const template = realtimeIncomingPool[incomingPoolIndex % realtimeIncomingPool.length];
                    incomingPoolIndex++;

                    const uniqueId = 'logi-live-' + Date.now();
                    newlyAddedJob = {
                        ...template,
                        id: uniqueId,
                        postedMinutesAgo: 0,
                        isNewRealtime: true
                    };

                    const existingIdx = jobsData.findIndex(j => j.title === newlyAddedJob.title && j.company === newlyAddedJob.company);
                    if (existingIdx !== -1) {
                        jobsData.splice(existingIdx, 1);
                    }
                    jobsData.unshift(newlyAddedJob);
                }

                // Update Last Sync Time
                const nowStr = new Date().toLocaleTimeString('vi-VN', { hour12: false });
                document.getElementById('statLastSync').textContent = nowStr;
                if (syncStatus) syncStatus.textContent = `Đã đồng bộ lúc ${nowStr}`;
                if (syncIcon) syncIcon.classList.remove('fa-spin');

                logTerminal(`★ Đã nạp bài đăng từ [${newlyAddedJob.source}]: "${newlyAddedJob.title.slice(0, 42)}..."`, 'success');

                showToast(
                    `Bài đăng mới từ ${newlyAddedJob.source}`,
                    `${newlyAddedJob.title} (${newlyAddedJob.company})`,
                    'emerald'
                );

                // Reset countdown
                currentCountdown = syncIntervalSeconds;
                updateCountdownUI();
                renderJobs();
            }, 400);
        }

