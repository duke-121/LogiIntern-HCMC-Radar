        // Smart URL Resolver: Builds exact post deep-links instead of generic homepages
        function resolveJobLinks(job) {
            const cleanTitle = job.title.replace(/\(.*?\)/g, '').trim();
            const cleanCompany = job.company.replace(/\(.*?\)|Chi nhánh.*|Văn phòng.*/gi, '').trim();
            const domain = job.sourceDomain || 'topcv.vn';

            // 1. Google Jobs Exact Card Link
            const googleJobsUrl = `https://www.google.com/search?q=${encodeURIComponent(`${cleanTitle} ${cleanCompany} TP.HCM tuyển dụng`)}&ibp=htl;jobs`;

            // 2. Direct Post "I'm Feeling Lucky" / Site-Specific Post Resolver
            const luckyPostUrl = `https://www.google.com/search?btnI=1&q=${encodeURIComponent(`site:${domain} "${cleanTitle}" "${cleanCompany}"`)}`;

            // 3. Primary Original Post Link
            let primaryPostUrl = job.externalUrl;
            if (!job.isDirectPostUrl) {
                // Build a specific query on the target platform with exact Title + Company so it shows the exact post first
                const exactQuery = encodeURIComponent(`${cleanTitle} ${cleanCompany}`);
                if (job.source.includes('LinkedIn')) {
                    primaryPostUrl = `https://www.linkedin.com/jobs/search/?keywords=${encodeURIComponent(cleanTitle + ' ' + cleanCompany)}&location=Ho%20Chi%20Minh%20City`;
                } else if (job.source.includes('VietnamWorks')) {
                    primaryPostUrl = `https://www.vietnamworks.com/viec-lam?q=${encodeURIComponent(cleanTitle)}&l=29`;
                } else if (job.source.includes('Glints')) {
                    primaryPostUrl = `https://glints.com/vn/opportunities/jobs/explore?keyword=${encodeURIComponent(cleanTitle + ' ' + cleanCompany)}`;
                } else if (job.source.includes('TopCV')) {
                    primaryPostUrl = `https://www.google.com/search?btnI=1&q=${encodeURIComponent(`site:topcv.vn/viec-lam "${cleanTitle}" TP.HCM`)}`;
                } else if (job.source.includes('CareerViet')) {
                    primaryPostUrl = `https://www.google.com/search?btnI=1&q=${encodeURIComponent(`site:careerviet.vn/vi/tim-viec-lam "${cleanTitle}" Hồ Chí Minh`)}`;
                } else if (job.source.includes('JobsGO') || job.source.includes('Ybox')) {
                    primaryPostUrl = `https://www.google.com/search?btnI=1&q=${encodeURIComponent(`site:jobsgo.vn/viec-lam "${cleanTitle}" Hồ Chí Minh`)}`;
                }
            }

            return {
                primaryPostUrl,
                googleJobsUrl,
                luckyPostUrl
            };
        }

